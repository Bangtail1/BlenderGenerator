# ==============================================================================
# Blender Asset Vault — Environment Configuration Example
# Copy this file to .env and fill in values as needed. Never commit .env!
# ==============================================================================

# Application server
VAULT_HOST=127.0.0.1
VAULT_PORT=8765
VAULT_DATA_DIR=./vault_storage
VAULT_LOG_LEVEL=INFO

# Blender executable path (auto-detected if on standard Windows path, or set explicitly)
BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 5.3\blender.exe
BLENDER_TIMEOUT_SECONDS=300
BLENDER_RENDER_ENGINE=BLENDER_EEVEE
BLENDER_RENDER_SAMPLES=16
BLENDER_RENDER_RESOLUTION=768

# Google Drive OAuth 2.0 (Official Google Drive API v3)
# Place your Google Cloud Desktop OAuth client JSON at this path (never commit it).
GDRIVE_CLIENT_SECRETS_PATH=./credentials/client_secrets.json
# Stored OAuth refresh/access token path (encrypted locally when VAULT_TOKEN_ENCRYPTION_KEY is set or DPAPI/restricted)
GDRIVE_TOKEN_PATH=./credentials/gdrive_token.json
# Narrowest practical OAuth scope for creating & managing app-created vault folders/files
GDRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
# Optional: specify an existing destination Drive folder ID; leave empty to create/use "Blender Asset Vault"
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_ROOT_FOLDER_NAME=Blender Asset Vault

# Optional: Multimodal Vision QA Provider (Stage 1 Automated Visual Review)
# Options: none | gemini | openai | ollama
# Leave as 'none' (or omit API keys) to route assets directly to mandatory Stage 2 Human Review.
VISION_QA_PROVIDER=none
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Optional: External Text-to-3D Provider (modular plugin point; disabled by default)
EXTERNAL_3D_PROVIDER=none
EXTERNAL_3D_API_KEY=
